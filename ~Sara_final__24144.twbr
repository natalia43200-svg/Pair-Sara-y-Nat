      <column caption='x' datatype='real' name='[Calculation_0674061254656000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Season]&#13;&#10;WHEN &quot;Classic Cars&quot; THEN 1&#13;&#10;WHEN &quot;Motorcycles&quot; THEN 2&#13;&#10;WHEN &quot;Planes&quot; THEN 3&#13;&#10;WHEN &quot;Ships&quot; THEN 4&#13;&#10;WHEN &quot;Trains&quot; THEN 5&#13;&#10;WHEN &quot;Vintage Cars&quot; THEN 6&#13;&#10;END' />
      </column>
      <column caption='tem+cap3' datatype='string' name='[Calculation_0674061320392705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;T&quot;+STR([season (friends_info.csv1)])+&quot;C&quot;+STR([episode (friends_info.csv1)])' />
      </column>
      <column caption='Author _clean' datatype='string' name='[Calculation_0907432274042882]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='PROPER(TRIM([author]))' />
      </column>
      <column caption='Oh my god' datatype='boolean' name='[Calculation_0907432277209093]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CONTAINS(LOWER([quote]) , &apos;oh my god&apos;)' />
      </column>
      <column aggregation='CountD' caption='temp+cap' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_0907432279707655]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;T&quot;+STR([Season])+&quot;C&quot;+STR([Episode Number])' />
